---
layout: base.njk
permalink: /forloeb/
side: forloeb
eleventyComputed:
  titel: "{{ forloeb.titel }}"
  beskrivelse: "{{ forloeb.beskrivelse }}"
---
<div class="pagehead">
  <div class="wrap">
    <span class="eyebrow">{{ forloeb.hero_mikrotekst }}</span>
    <h1>{{ forloeb.hero_overskrift }}</h1>
    <p>{{ forloeb.hero_tekst }}</p>
  </div>
</div>

{# Sandfarvet, ikke groen: sidehovedet ovenfor er allerede lysegroent, og de
   to blokke ville ellers smelte sammen til ét felt med et hul i midten. #}
<section class="section section--sand">
  <div class="wrap">
    {# Ingen overskrift her: siden hedder allerede "Praktisk info", og
       "Det praktiske" lige nedenunder sagde det samme en gang til. #}
    <div class="grid grid--3 grid--3-fast">
      {% for k in forloeb.praktisk_kort %}
      <article class="card card--flat"><h3>{{ k.overskrift }}</h3><p>{{ k.tekst }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap wrap--narrow">
    <div class="section-head">
      <h2>{{ forloeb.faq_overskrift }}</h2>
    </div>
    <div class="faq">
      {% for f in forloeb.faq %}
      <details>
        <summary>{{ f.spoergsmaal }}</summary>
        <div class="faq__body">{{ f.svar | afsnit | safe }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap">
    <div class="cta">
      <h2>{{ forloeb.cta_overskrift }}</h2>
      <p>{{ forloeb.cta_tekst }}</p>
      <div class="btn-row">
        <a class="btn btn--light" href="tel:{{ site.telefon_link }}">Ring {{ site.telefon }}</a>
        <a class="btn btn--outline-light" href="/kontakt/">Se kontaktinfo</a>
      </div>
    </div>
  </div>
</section>
