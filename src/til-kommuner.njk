---
layout: base.njk
permalink: /til-kommuner/
side: kommuner
eleventyComputed:
  titel: "{{ kommuner.titel }}"
  beskrivelse: "{{ kommuner.beskrivelse }}"
---
{# Overskriften ligger i fuld bredde over spalterne, saa "Kort fortalt" og
   billedet begynder i samme hoejde og staar side om side. #}
<section class="hero">
  <div class="wrap hero__titel">
    <span class="eyebrow">{{ kommuner.hero_mikrotekst }}</span>
    <h1>{{ kommuner.hero_overskrift }}</h1>
  </div>

  {# Resuméet og billedet ligger i samme raekke, saa billedrammen straekker
     sig ned og flugter med bunden af "Kort fortalt". Knapperne ligger i
     raekken under, i venstre spalte. #}
  <div class="wrap hero__inner hero__inner--utop hero__inner--flugt">
    <div class="resume resume--top">
      <h2 class="resume__titel">{{ kommuner.resume_overskrift }}</h2>
      {% for r in kommuner.resume_punkter %}
      <div class="resume__row">
        <span class="resume__label">{{ r.label }}</span>
        <span>{{ r.tekst }}</span>
      </div>
      {% endfor %}
    </div>

    <figure class="figur">
      <div class="hero__media">
        <img src="{{ kommuner.hero_billede }}" alt="{{ kommuner.hero_billede_alt }}" width="600" height="800">
      </div>
      {% if kommuner.hero_billedtekst %}<figcaption>{{ kommuner.hero_billedtekst }}</figcaption>{% endif %}
    </figure>

    <div class="btn-row">
      <a class="btn btn--primary" href="tel:{{ site.telefon_link }}">Ring {{ site.telefon }}</a>
      <a class="btn btn--ghost" href="mailto:{{ site.email }}?subject=Foresp%C3%B8rgsel%20fra%20kommune">{{ kommuner.hero_knap2 }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ kommuner.relevant_overskrift }}</h2>
      <p>{{ kommuner.relevant_intro }}</p>
    </div>
    <div class="grid grid--3 grid--3-fast">
      {% for k in kommuner.relevant_kort %}
      <article class="card card--flat">
        <h3>{{ k.overskrift }}</h3>
        <p>{{ k.tekst }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--sand">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ kommuner.forskel_overskrift }}</h2>
      <p>{{ kommuner.forskel_intro }}</p>
    </div>
    <div class="grid grid--2 grid--2-fast">
      {% for k in kommuner.forskel_kort %}
      <article class="card card--flat">
        <h3>{{ k.overskrift }}</h3>
        <p>{{ k.tekst }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# Alt det, ingen laeser paa skaermen, men som skal kunne findes: lovtekst,
   forloebets opbygning og de praktiske forhold. Foldet sammen som paa
   Praktisk info-siden. #}
<section class="section">
  <div class="wrap wrap--narrow">
    <div class="section-head">
      <h2>{{ kommuner.detaljer_overskrift }}</h2>
      <p>{{ kommuner.detaljer_intro }}</p>
    </div>
    <div class="faq">

      <details>
        <summary>{{ kommuner.forloeb_overskrift }}</summary>
        <div class="faq__body">
          <ol class="trinliste">
            {% for t in kommuner.forloeb_trin %}
            <li><strong>{{ t.overskrift }}.</strong> {{ t.tekst }}</li>
            {% endfor %}
          </ol>
        </div>
      </details>

      <details>
        <summary>{{ kommuner.lov_overskrift }}</summary>
        <div class="faq__body">
          <p>{{ kommuner.lov_intro }}</p>
          <h3>{{ kommuner.lov_kort1_overskrift }}</h3>
          {{ kommuner.lov_kort1_tekst | afsnit | safe }}
          <h3>{{ kommuner.lov_kort2_overskrift }}</h3>
          {{ kommuner.lov_kort2_tekst | afsnit | safe }}
          <h3>{{ kommuner.lov_kort2_overskrift2 }}</h3>
          {{ kommuner.lov_kort2_tekst2 | afsnit | safe }}
        </div>
      </details>

      <details>
        <summary>{{ kommuner.praktisk_overskrift }}</summary>
        <div class="faq__body">
          <ul>
            {% for k in kommuner.praktisk_kort %}
            <li><strong>{{ k.overskrift }}.</strong> {{ k.tekst }}</li>
            {% endfor %}
          </ul>
          <p><a href="/forloeb/">{{ kommuner.praktisk_link }}</a></p>
        </div>
      </details>

    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap">
    <div class="sister">
      <div>
        <h3>{{ kommuner.soester_overskrift }}</h3>
        <p>{{ kommuner.soester_tekst }}</p>
      </div>
      <a class="btn btn--brand" href="{{ site.soestersite_url }}">{{ kommuner.soester_knap }}</a>
    </div>
  </div>
</section>

{# Den groenne kontaktboks bruges kun paa forsiden, rideterapi og
   handicapridning. #}
