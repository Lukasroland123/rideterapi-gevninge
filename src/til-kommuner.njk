---
layout: base.njk
permalink: /til-kommuner/
side: kommuner
eleventyComputed:
  titel: "{{ kommuner.titel }}"
  beskrivelse: "{{ kommuner.beskrivelse }}"
---
<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <span class="eyebrow">{{ kommuner.hero_mikrotekst }}</span>
      <h1>{{ kommuner.hero_overskrift }}</h1>
      <p class="lead">{{ kommuner.hero_tekst }}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="tel:{{ site.telefon_link }}">Ring {{ site.telefon }}</a>
        <a class="btn btn--ghost" href="mailto:{{ site.email }}?subject=Foresp%C3%B8rgsel%20fra%20kommune">{{ kommuner.hero_knap2 }}</a>
      </div>
    </div>
    <div class="hero__media">
      <img src="{{ kommuner.hero_billede }}" alt="{{ kommuner.hero_billede_alt }}" width="800" height="600">
    </div>
  </div>
</section>

{# Terminologien forvirrer: "rideterapi" er det ord, folk soeger paa, men
   det daekker to forskellige ydelser. Det staar derfor foerst paa siden. #}
<section class="section section--tight">
  <div class="wrap wrap--narrow">
    <div class="note">
      <strong>{{ kommuner.ord_titel }}</strong> {{ kommuner.ord_tekst | afsnit | safe }}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ kommuner.relevant_overskrift }}</h2>
      <p>{{ kommuner.relevant_intro }}</p>
    </div>
    <div class="grid grid--3 grid--3-fast">
      {% for k in kommuner.relevant_kort %}
      <article class="card card--flat">
        <h3>{{ k.overskrift }}</h3>
        <p>{{ k.tekst }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# "Hvem udfoerer forloebet?" og publikationsboksen er fjernet —
   den fulde faglige baggrund staar paa /om-lotte/. #}

<section class="section section--sand">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ kommuner.forskel_overskrift }}</h2>
      <p>{{ kommuner.forskel_intro }}</p>
    </div>
    <div class="grid grid--2 grid--2-fast">
      {% for k in kommuner.forskel_kort %}
      <article class="card card--flat">
        <h3>{{ k.overskrift }}</h3>
        {{ k.tekst | afsnit | safe }}
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap wrap--narrow prose">
    <span class="eyebrow">{{ kommuner.besoeg_mikrotekst }}</span>
    <h2>{{ kommuner.besoeg_overskrift }}</h2>
    {{ kommuner.besoeg_tekst | afsnit | safe }}
    <div class="btn-row">
      <a class="btn btn--primary" href="tel:{{ site.telefon_link }}">Ring {{ site.telefon }}</a>
      <a class="btn btn--ghost" href="mailto:{{ site.email }}?subject=Foresp%C3%B8rgsel%20fra%20kommune">{{ kommuner.hero_knap2 }}</a>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ kommuner.forloeb_overskrift }}</h2>
    </div>
    <div class="steps">
      {% for t in kommuner.forloeb_trin %}
      <article class="step">
        <h3>{{ t.overskrift }}</h3>
        <p>{{ t.tekst }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ kommuner.lov_overskrift }}</h2>
      <p>{{ kommuner.lov_intro }}</p>
    </div>
    <div class="grid grid--2">
      <article class="card card--flat">
        <h3>{{ kommuner.lov_kort1_overskrift }}</h3>
        {{ kommuner.lov_kort1_tekst | afsnit | safe }}
      </article>
      <article class="card card--flat">
        <h3>{{ kommuner.lov_kort2_overskrift }}</h3>
        {{ kommuner.lov_kort2_tekst | afsnit | safe }}
        <h3 style="margin-top:1.5rem">{{ kommuner.lov_kort2_overskrift2 }}</h3>
        {{ kommuner.lov_kort2_tekst2 | afsnit | safe }}
      </article>
    </div>
  </div>
</section>

<section class="section section--sand">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ kommuner.praktisk_overskrift }}</h2>
    </div>
    <div class="grid grid--3 grid--3-fast">
      {% for k in kommuner.praktisk_kort %}
      <article class="card card--flat"><h3>{{ k.overskrift }}</h3><p>{{ k.tekst }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap">
    <div class="sister">
      <div>
        <h3>{{ kommuner.soester_overskrift }}</h3>
        <p>{{ kommuner.soester_tekst }}</p>
      </div>
      <a class="btn btn--brand" href="{{ site.soestersite_url }}">{{ kommuner.soester_knap }}</a>
    </div>
  </div>
</section>

{# Den groenne kontaktboks bruges kun paa forsiden, rideterapi og
   handicapridning. #}
