<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titel | safe }}</title>
<meta name="description" content="{{ beskrivelse | safe }}">
<link rel="canonical" href="{{ site.domaene }}{{ page.url }}">
<link rel="stylesheet" href="/assets/css/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐴</text></svg>">
<meta property="og:type" content="website">
<meta property="og:locale" content="da_DK">
<meta property="og:site_name" content="{{ site.navn }}">
<meta property="og:title" content="{{ titel | safe }}">
<meta property="og:description" content="{{ beskrivelse | safe }}">
<meta property="og:url" content="{{ site.domaene }}{{ page.url }}">
<meta property="og:image" content="{{ site.domaene }}{{ og_billede | default("/billeder/forside-barn-paa-hesteryg.jpg", true) }}">
<meta name="twitter:card" content="summary_large_image">

{#- Struktureret data ligger i sin egen fil, saa den kan vokse uden at goere
    base.njk ulaeselig. Den koeres paa ALLE sider - ikke kun forsiden -
    fordi hver side beskriver sin egen enhed i den samlede graf. -#}
{% include "schema.njk" %}
</head>
<body>

<a class="skip-link" href="#indhold">Gå til indhold</a>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="/">
      <span class="logo__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 20v-5.5c0-1.2.4-2 1.3-2.8C4.5 11 4 10 4 8.8 4 7 5.2 5.6 6.6 5l.7 1.6a2 2 0 0 1 2.8 1.6l4.4.4 1.9-3.6 2.1.8-1.1 3.7 1.4.7c1.3.7 2.2 2 2.2 3.6V20h-2.6v-5.2c0-.6-.3-1.1-.8-1.4l-1-.5V20h-2.6v-6.3H8.8V20H6.2v-6.4c-.4.3-.6.7-.6 1.2V20z"/></svg>
      </span>
      <span>{{ site.navn }}
        <small>{{ site.undertitel }}</small>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hovedmenu">
      <svg class="nav-toggle__open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="nav-toggle__close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      Menu
    </button>

    <nav class="nav" id="hovedmenu" aria-label="Hovedmenu">
      <a href="/"{% if side == 'forside' %} aria-current="page"{% endif %}>Forside</a>

      <div class="nav__group">
        <button class="nav__parent" type="button" aria-expanded="false" aria-controls="undermenu-forloeb"{% if side in ['rideterapi','handicapridning','faellesskabsforloeb'] %} aria-current="true"{% endif %}>Forløb</button>
        <ul class="nav__sub" id="undermenu-forloeb">
          <li><a href="/rideterapi/"{% if side == 'rideterapi' %} aria-current="page"{% endif %}>Hesteassisteret behandling<small>Rideterapi</small></a></li>
          <li><a href="/handicapridning/"{% if side == 'handicapridning' %} aria-current="page"{% endif %}>Handicapridning<small>Kompenserende ridning</small></a></li>
          <li><a href="/faellesskabsforloeb/"{% if side == 'faellesskabsforloeb' %} aria-current="page"{% endif %}>Fællesskabsforløb<small>Gruppeforløb i små hold</small></a></li>
        </ul>
      </div>

      {#- "Praktisk info" er flyttet ud af Forloeb-menuen og staar nu sammen med
          priserne i sin egen menu. Begge sider beholder deres egne adresser. #}
      <div class="nav__group">
        <button class="nav__parent" type="button" aria-expanded="false" aria-controls="undermenu-praktisk"{% if side in ['forloeb','priser'] %} aria-current="true"{% endif %}>Praktisk info &amp; priser</button>
        <ul class="nav__sub" id="undermenu-praktisk">
          <li><a href="/forloeb/"{% if side == 'forloeb' %} aria-current="page"{% endif %}>Praktisk info<small>Tøj, sikkerhed og spørgsmål</small></a></li>
          <li><a href="/priser/"{% if side == 'priser' %} aria-current="page"{% endif %}>Priser<small>Priser, kontrakter og tilskud</small></a></li>
        </ul>
      </div>
      <a href="/om-lotte/"{% if side == 'omlotte' %} aria-current="page"{% endif %}>Om Lotte</a>
      <a href="/kontakt/"{% if side == 'kontakt' %} aria-current="page"{% endif %}>Kontakt</a>
      <a href="/til-kommuner/"{% if side == 'kommuner' %} aria-current="page"{% endif %}>Til kommuner</a>
      {% if side == 'kontakt' %}
      <a class="btn btn--primary" href="tel:{{ site.telefon_link }}">Ring {{ site.telefon }}</a>
      {% else %}
      <a class="btn btn--primary" href="/kontakt/">{{ site.cta_knap }}</a>
      {% endif %}
    </nav>
  </div>
</header>

<main id="indhold">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer__brand">{{ site.navn }}</div>
        <p>{{ site.footer_beskrivelse }}</p>
        <p>{{ site.adresse }}<br>{{ site.postnr_by }}</p>
      </div>
      <div>
        <h4>Sider</h4>
        <ul>
          <li><a href="/">Forside</a></li>
          <li><a href="/rideterapi/">Hesteassisteret behandling</a></li>
          <li><a href="/handicapridning/">Handicapridning</a></li>
          <li><a href="/faellesskabsforloeb/">Fællesskabsforløb</a></li>
          <li><a href="/forloeb/">Praktisk info</a></li>
          <li><a href="/priser/">Priser &amp; kontrakter</a></li>
          <li><a href="/om-lotte/">Om Lotte</a></li>
          <li><a href="/til-kommuner/">Til kommuner</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
      </div>
      <div>
        <h4>Kontakt</h4>
        <ul>
          <li>Tlf. <a href="tel:{{ site.telefon_link }}">{{ site.telefon }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{{ site.facebook }}" rel="noopener">Facebook</a></li>
          <li><a href="{{ site.soestersite_url }}">{{ site.soestersite_navn }} &ndash; terapi</a></li>
          <li>CVR. {{ site.cvr }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 {{ site.navn }} &middot; Alle rettigheder forbeholdt</p>
      <ul>
        <li><a href="/privatlivspolitik/">Privatlivspolitik</a></li>
        <li><a href="/forloeb/#ansvar">Ansvar og forsikring</a></li>
        {% if side != 'privatliv' %}
        <li>
          <a class="rediger-link" href="/admin/#/collections/sider/entries/{{ side }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
            Rediger denne side
          </a>
        </li>
        {% endif %}
      </ul>
    </div>
  </div>
</footer>

<script src="/assets/js/site.js"></script>
</body>
</html>
