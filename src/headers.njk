# Cloudflare Pages laeser denne fil fra roden af det byggede site.
# Den svarer til [[headers]]-blokkene i netlify.toml, saa siden opfoerer sig
# ens uanset hvor den hostes. Mest specifikke regel foerst.

/admin/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
